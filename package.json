{
  "name": "view-transition-wave",
  "version": "0.1.0",
  "description": "distortion-wave's transition, played as a native View Transition: the browser snapshots the page, an SVG filter bends it and a WebGL overlay lights it.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && npx --yes serve -l 4321 .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "view-transitions",
    "transition",
    "distortion",
    "shockwave",
    "webgl2",
    "svg-filter",
    "animation",
    "dom"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "distortion-wave": "^0.2.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
